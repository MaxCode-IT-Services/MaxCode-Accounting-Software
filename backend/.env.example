# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/maxcode-invoice?retryWrites=true&w=majority

# For local MongoDB
# MONGODB_URI=mongodb://localhost:27017/maxcode-invoice

# JWT Authentication
# IMPORTANT: Change this to a strong random string in production!
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production

# Project Credentials Encryption Key (required, exactly 32 bytes)
# Generate hex key: openssl rand -hex 32
# Or Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=your-64-char-hex-key

# Optional: Custom token expiry (default: 365d / 1 year)
# JWT_EXPIRES_IN=365d

# Backup API Key (for automated backups via GitHub Actions)
# Generate a strong random key: openssl rand -hex 32
# Or use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_API_KEY=your-backup-api-key-change-me-in-production
