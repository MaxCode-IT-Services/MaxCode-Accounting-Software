# Server Environment Variables

Copy this file to `backend/.env` on your server and fill in the values.

# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/maxcode
DB_NAME=maxcode

# ── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# ── Encryption ──────────────────────────────────────────────────────────────
CREDENTIALS_ENCRYPTION_KEY=your-128-char-hex-key-here
# CREDENTIALS_ENCRYPTION_KEY_OLD=previous-key-for-rotation

# ── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-token

# ── Cloudflare Turnstile ───────────────────────────────────────────────────
CLOUDFLARE_TURNSTILE_SITE_KEY=your-site-key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-secret-key

# ── Google Drive Backup ────────────────────────────────────────────────────
GOOGLE_DRIVE_CLIENT_ID=your-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3000
