# Environment Variables Template

# Copy this file to .env in both backend/ and root directory

# DO NOT commit .env files to version control

# ============================================

# MongoDB Configuration

# ============================================

# MongoDB Connection String

# For MongoDB Atlas (Production):

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/maxcode-invoice?retryWrites=true&w=majority

# For Local MongoDB (Development):

# MONGODB_URI=mongodb://localhost:27017/maxcode-invoice

# MongoDB Database Name

DB_NAME=maxcode-invoice

# ============================================

# JWT Authentication

# ============================================

# JWT Secret Key for signing tokens

# IMPORTANT: Generate a strong random string for production!

# You can use: openssl rand -base64 64

JWT_SECRET=your-super-secret-jwt-key-change-me-in-production

# Project credentials field-level encryption key (required)
# Must be exactly 32 bytes. Recommended format: 64-char hex.
# Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=your-64-char-hex-key

# Token expiry (default: 365d = 1 year)

JWT_EXPIRES_IN=365d

# ============================================

# Netlify Configuration

# ============================================

# NOTE: These variables need to be set in Netlify Dashboard

# Site settings → Environment variables

# Required for backend functions:

# - MONGODB_URI

# - JWT_SECRET

# - CREDENTIALS_ENCRYPTION_KEY

# - DB_NAME (optional)

# Optional Telegram router credentials (env first, Settings/DB fallback):

# - MAXCODE_SHARED_SECRET

# - MAXCODE_BOT_ID

# - MAXCODE_CONNECTION_ID

# ============================================

# Optional Configuration

# ============================================

# NODE_ENV=production

# PORT=8888

# ============================================

# Setup Instructions

# ============================================

# 1. Create a MongoDB Atlas account at https://cloud.mongodb.com

# 2. Create a new cluster (free tier available)

# 3. Create a database user with read/write permissions

# 4. Get your connection string and replace username/password

# 5. Whitelist your IP or use 0.0.0.0/0 for development

# 6. Generate a strong JWT secret: openssl rand -base64 64

# 7. Copy this file to .env in the backend directory

# 8. Add MONGODB_URI and JWT_SECRET to Netlify environment variables for production
